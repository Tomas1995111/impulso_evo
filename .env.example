# Impulso Evo - Variables de Entorno
# IMPORTANTE: Copia este archivo a .env y completa con tus valores reales.
# El archivo .env NUNCA debe ser commiteado a git (ver .gitignore).

# ===== Evolution API (WhatsApp) =====
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=TU_API_KEY_AQUI
EVOLUTION_INSTANCE_NAME=Impulso

# ===== Postgres (BD de Evolution) =====
# IMPORTANTE: cambiar POSTGRES_PASSWORD en producción.
# Si ya tenés el volumen postgres_data con la password anterior, mantené ese valor acá.
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=evolution

